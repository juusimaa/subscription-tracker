# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / React
node_modules/
dist/
build/
.vite/

# Env files
.env
.env.*
!.env.example

# Docker
*.log

# The default test database: conftest.py points DATABASE_URL at a throwaway
# SQLite file so `pytest` works with nothing running. It is rebuilt from
# models.py on every test, so a committed copy would be worse than useless.
backend/test.db

# Generated API docs. The spec is built from the app (see
# .github/workflows/docs.yml), so a local run of that command leaves a _site/
# behind that must not be committed -- a checked-in copy is exactly the drift
# generating it was meant to avoid.
_site/

# Claude Code local state: personal permissions and agent worktrees
.claude/settings.local.json
.claude/worktrees/
.claude/skills/
.github/skills/
.claude/agents/impeccable-*.md
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json
# The same skill installed for Codex and other agents: a copy of the skill,
# its subagents and its hooks, all regenerated by `impeccable install`.
.agents/skills/
.codex/agents/impeccable-*.toml
.codex/hooks.json

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Dated /impeccable critique reports: point-in-time reviews kept for the
# tool's own trend comparison. Open findings are filed as issues instead.
.impeccable/critique/
