POSTGRES_DB=subscriptions
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+psycopg://postgres:devpassword@db:5432/subscriptions
# Backs app/cache.py's cache-aside layer. "redis", not "localhost", for the
# same reason DATABASE_URL says "db" above -- see that line's comment.
REDIS_URL=redis://redis:6379/0
VITE_API_URL=http://localhost:8000

# Origin(s) the backend's CORS middleware allows, comma-separated. This is
# the browser's address for the frontend, so "localhost", not "frontend" --
# same reasoning as VITE_API_URL above. Add the deployed frontend's origin
# here (comma-separated) once this app runs anywhere but local Compose.
CORS_ORIGINS=http://localhost:5173

# Signs the JWTs issued by /token. Generate your own -- do NOT use this
# placeholder, and never commit the real value (.env is gitignored):
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every token already issued, logging everyone out.
SECRET_KEY=replace-me-with-a-generated-key

# Cloudflare Turnstile, the bot check on signup and password-reset requests
# (backend/app/turnstile.py, frontend/src/Turnstile.jsx). Both blank, the
# default, switches it off. Set both or neither: the site key is what makes
# the frontend show the widget, the secret what makes the backend demand its
# answer. Cloudflare's always-pass test pair, for trying it locally:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   TURNSTILE_HOSTNAMES=example.com
# TURNSTILE_HOSTNAMES lists the hostnames a token may be solved on; the test
# secret always answers example.com. Production sets TURNSTILE_SITE_KEY (no
# VITE_ prefix) on the frontend app, and TURNSTILE_HOSTNAMES=subscriptionstrack.com.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Outgoing email: verification and password-reset links (PLAN.md milestone
# 9, backend/app/mailer.py). "console" (the default) sends nothing and logs
# each message instead, links included -- find them with
# `docker compose logs backend`. Production sets EMAIL_BACKEND=resend plus
# RESEND_API_KEY, and EMAIL_FROM on the domain verified in Resend.
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=Subscription Tracker <no-reply@localhost>
# Where links in those emails point: the frontend's address in the browser.
APP_URL=http://localhost:5173
# Most emails the app sends in any 24 hours, all addresses together. Resend's
# free tier stops at 100 a day; this stops short of it. Each address also
# gets at most 5 a day.
EMAIL_DAILY_CAP=90

# Production only, never local. Behind Azure Container Apps' ingress every
# request arrives from the proxy, so the rate limits (backend/app/main.py)
# must read the real client from the last X-Forwarded-For entry. Without a
# proxy in front, the client sets that header itself, so leave this false.
TRUST_FORWARDED_FOR=false
