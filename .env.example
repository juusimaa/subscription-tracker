POSTGRES_DB=subscriptions
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+psycopg://postgres:devpassword@db:5432/subscriptions
# Backs app/cache.py's cache-aside layer. "redis", not "localhost", for the
# same reason DATABASE_URL says "db" above -- see that line's comment.
REDIS_URL=redis://redis:6379/0
VITE_API_URL=http://localhost:8000

# Signs the JWTs issued by /token. Generate your own -- do NOT use this
# placeholder, and never commit the real value (.env is gitignored):
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every token already issued, logging everyone out.
SECRET_KEY=replace-me-with-a-generated-key
