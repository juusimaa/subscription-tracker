POSTGRES_DB=subscriptions
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+psycopg://postgres:devpassword@db:5432/subscriptions
# Backs app/cache.py's cache-aside layer. "redis", not "localhost", for the
# same reason DATABASE_URL says "db" above -- see that line's comment.
REDIS_URL=redis://redis:6379/0
VITE_API_URL=http://localhost:8000

# Origin(s) the backend's CORS middleware allows, comma-separated. This is
# the browser's address for the frontend, so "localhost", not "frontend" --
# same reasoning as VITE_API_URL above. Add the deployed frontend's origin
# here (comma-separated) once this app runs anywhere but local Compose.
CORS_ORIGINS=http://localhost:5173

# Signs the JWTs issued by /token. Generate your own -- do NOT use this
# placeholder, and never commit the real value (.env is gitignored):
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every token already issued, logging everyone out.
SECRET_KEY=replace-me-with-a-generated-key

# Optional. Left blank, /register stays open, which is what local dev and
# the test suite both want. Set it to any shared secret before the app is
# reachable on a public URL -- POST /register then rejects any request whose
# invite_code doesn't match. Email verification (PLAN.md milestone 9) exists
# now, but the invite code stays while the app is in beta.
INVITE_CODE=

# Outgoing email: verification and password-reset links (PLAN.md milestone
# 9, backend/app/mailer.py). "console" (the default) sends nothing and logs
# each message instead, links included -- find them with
# `docker compose logs backend`. Production sets EMAIL_BACKEND=resend plus
# RESEND_API_KEY, and EMAIL_FROM on the domain verified in Resend.
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=Subscription Tracker <no-reply@localhost>
# Where links in those emails point: the frontend's address in the browser.
APP_URL=http://localhost:5173
