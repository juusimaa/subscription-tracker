# Dummy values for every variable in /etc/subscription-tracker/.env
# (specs/001-upcloud-migration/contracts/server-env.md), so CI can run
# `docker compose config` and the edge tests without the real file.
#
# It must never hold a real value. Everything here is either obviously fake
# or a local-only hostname.

# --- app ---
DATABASE_URL=postgresql+psycopg://app:not-a-password@db.invalid:5432/subscriptions?sslmode=require
SECRET_KEY=not-a-secret
CORS_ORIGINS=https://app.localhost
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
TURNSTILE_SITE_KEY=
EMAIL_BACKEND=console
RESEND_API_KEY=not-a-key
EMAIL_FROM=Subscription Tracker <no-reply@example.invalid>
APP_URL=https://app.localhost
EMAIL_DAILY_CAP=90
# REDIS_URL is left out on purpose: production runs with no cache (FR-014).

# --- edge ---
APP_HOST=app.localhost
API_HOST=api.localhost
ACME_EMAIL=ops@example.invalid
CADDY_TEST_GLOBALS=

# --- operations (ops-check.py only) ---
ALERT_EMAIL=ops@example.invalid
DB_STORAGE_GIB=10
UPTIMEROBOT_HEARTBEAT_URL=

# --- deploy record ---
# Lives in /var/lib/subscription-tracker/image-tag.env on the server, not in
# the secrets file (deploy.sh must be able to write it). Here only so
# `docker compose config` can resolve the image names.
IMAGE_TAG=sha-0000000
