DATABASE_URL=postgresql+psycopg://postgres:devpassword@localhost:5432/subscriptions
# Optional: app/cache.py fails open (falls back to Postgres) if this is unset
# or unreachable, so the app runs fine without a local Redis. Point it at a
# real one to actually exercise the cache -- `docker run -p 6379:6379
# redis:7-alpine` is the quickest way to get one running on the host.
REDIS_URL=redis://localhost:6379/0

# See the note in the root .env.example. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-generated-key

# Optional -- see the note in the root .env.example. Left blank, signup and
# password reset have no bot check.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Optional -- see the note in the root .env.example. "console" logs emails
# instead of sending them.
EMAIL_BACKEND=console
APP_URL=http://localhost:5173
